# ── Etsy OAuth ──────────────────────────────────────────────────────────────
ETSY_API_KEY=your_etsy_api_key_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here
ETSY_REDIRECT_URI=http://localhost:8787/auth/etsy/callback
ETSY_SCOPE=listings_r listings_w

# ── AI Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
REMOVEBG_API_KEY=your_removebg_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Notion Integration ───────────────────────────────────────────────────────
NOTION_API_KEY=your_notion_api_key_here
# Top-level database container ID (from Notion URL: /database_id?v=...)
NOTION_DATABASE_ID=your_notion_database_id_here
# Data source ID (the actual table — from databases.retrieve > data_sources[0].id)
NOTION_DATA_SOURCE_ID=your_notion_data_source_id_here
# Notion Idea Bank database — stores saved reference listings (separate DB from main)
NOTION_IDEA_BANK_DATA_SOURCE_ID=your_notion_idea_bank_data_source_id_here

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=etsyauto-assets
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── App Internals ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./etsyauto.db
STATIC_DIR=./static
# Admin token — protects POST /admin/run-uploader; generate with: openssl rand -hex 32
ADMIN_TOKEN=your_admin_token_here
