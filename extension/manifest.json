{
  "manifest_version": 3,
  "name": "EtsyAuto Optimizer",
  "version": "0.4.4",
  "description": "Send Etsy listings to the local optimizer backend; capture public listing references to your Notion Idea Bank; create new Etsy listings from templates with per-color mockups.",

  "permissions": ["activeTab", "sidePanel", "storage"],
  "host_permissions": [
    "https://www.etsy.com/*",
    "http://localhost:8787/*",
    "http://172.16.10.168:8787/*",
    "https://etsy.datxanhmientrung.ai/*",
    "https://etsy.datxanhmientrung.ai:4333/*",
    "https://etsy.leesun.space/*"
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.etsy.com/your/shops/*",
        "https://www.etsy.com/listing/*",
        "https://www.etsy.com/*/listing/*"
      ],
      "js": ["shared/etsy-dom-extractor.js", "content-scripts/listing-detector.js"],
      "css": ["content-scripts/listing-detector.css"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "side-panel/side-panel.html"
  },

  "action": {
    "default_title": "EtsyAuto Optimizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
